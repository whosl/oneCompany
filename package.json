{
  "name": "onecompany",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "migrate": "turbo run migrate --filter=@oc/shared",
    "api": "pnpm --filter @oc/api dev",
    "tui2": "pnpm --filter @oc/tui start",
    "webui": "pnpm --filter @oc/webui dev",
    "onecompany": "pnpm --filter @onecompany/opencode onecompany",
    "opencode-plugin:build": "pnpm --filter @onecompany/opencode build",
    "opencode-plugin:install": "pnpm --filter @onecompany/opencode build && node packages/opencode-plugin/dist/cli.js install",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
