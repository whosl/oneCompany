# Copy to .env.docker and fill in before: docker compose up --build
#
# LLM (requirement / workflow agents)
OPENAI_API_KEY=
# OC_LLM_API_KEY=
# OC_LLM_BASE_URL=https://api.openai.com/v1

# OpenCode coding engine (install opencode CLI in the image or mount a custom image layer)
ZHIPU_API_KEY=
OC_OPENCODE_MODEL_CHEAP=zhipuai-coding-plan/glm-5.1
OC_OPENCODE_MODEL_STANDARD=zhipuai-coding-plan/glm-5.1
OC_OPENCODE_MODEL_STRONG=zhipuai-coding-plan/glm-5.1

# Integrations (image defaults: real Playwright + workflow checks + baked MCP servers)
# OC_INTEGRATION_ADAPTER_MODE=mock
# OC_TESTING_INTEGRATION_CHECKS=0
# PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers
# OC_MCP_SERVERS_ROOT=/opt/onecompany/mcp-servers

# P1 connectors (missing secret → offline skill pack in real mode)
FIGMA_ACCESS_TOKEN=
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=

# P2 connectors
CLOUDFLARE_API_TOKEN=
LINEAR_API_KEY=
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=
CONTEXT7_API_KEY=
DATABASE_URL=

# P3 connectors
STRIPE_SECRET_KEY=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
# KUBECONFIG=/opt/onecompany/config/kubeconfig
