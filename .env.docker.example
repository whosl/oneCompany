# OneCompany Docker deployment — copy to .env.docker and fill in before:
#   docker compose up --build
#
# Access after startup:
#   WebUI:  http://localhost:3010
#   API:    http://localhost:3001
#   TUI:    docker compose exec onecompany-api pnpm tui2 --api http://127.0.0.1:3001
#
# Pre-baked into the image (no config needed):
#   - codegraph CLI (@colbymchenry/codegraph) — code intelligence MCP
#   - opencode CLI (opencode-ai) — coding engine
#   - Playwright Chromium — browser verification
#   - MCP servers (figma/github/supabase/context7/...) under mcp-servers/

# ─── LLM (requirement / workflow agents) ────────────────────────────────────
OPENAI_API_KEY=
# OC_LLM_API_KEY=
# OC_LLM_BASE_URL=https://api.openai.com/v1

# ─── OpenCode coding engine ─────────────────────────────────────────────────
# opencode-ai is installed in the image. Model must be provider/model format.
ZHIPU_API_KEY=
OC_OPENCODE_MODEL_CHEAP=zhipuai-coding-plan/glm-5.1
OC_OPENCODE_MODEL_STANDARD=zhipuai-coding-plan/glm-5.1
OC_OPENCODE_MODEL_STRONG=zhipuai-coding-plan/glm-5.1

# ─── Integration secrets (optional — missing → offline skill pack) ──────────
# P1
FIGMA_ACCESS_TOKEN=
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=

# P2
CLOUDFLARE_API_TOKEN=
LINEAR_API_KEY=
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=
CONTEXT7_API_KEY=
DATABASE_URL=

# P3
STRIPE_SECRET_KEY=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
# KUBECONFIG=/opt/onecompany/config/kubeconfig
