{
  "name": "@oc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @oc/agent-core build",
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --external @oc/shared --external @oc/agent-core --external @oc/integrations --external @oc/workflow --external @oc/workspace --external drizzle-orm --external better-sqlite3",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@oc/agent-core": "workspace:^",
    "@oc/integrations": "workspace:^",
    "@oc/shared": "workspace:*",
    "@oc/workflow": "workspace:^",
    "@oc/workspace": "workspace:^",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.8.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
