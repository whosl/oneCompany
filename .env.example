# Workflow agents — any OpenAI-compatible LLM endpoint
OC_LLM_API_KEY=
OC_LLM_BASE_URL=https://api.deepseek.com/v1
OC_WORKFLOW_MODEL_CHEAP=deepseek-v4-flash
OC_WORKFLOW_MODEL_STANDARD=deepseek-v4-flash
OC_WORKFLOW_MODEL_STRONG=deepseek-v4-pro

# Optional legacy aliases (plain model ids only; provider/model refs are for opencode)
# OPENAI_API_KEY=
# OC_MODEL_CHEAP=
# OC_MODEL_STANDARD=
# OC_MODEL_STRONG=

# Tests / local stub engine
# OC_USE_STUB_ENGINE=1

# Roll back to hand-rolled requirement/development engines (pre-LangGraph)
# OC_USE_LEGACY_ENGINE=1

# Real opencode integration tests
# OC_OPENCODE_INTEGRATION=1

# Web dev (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=/api
# API_URL=http://localhost:3001

# Opencode (@opencode-ai/sdk pin in packages/agent-core/package.json)
# Gate wait timeout (ms). Development/opencode permission gates default to 0 = wait until user resolves.
# OC_GATE_WAIT_TIMEOUT_MS=0
# OC_GATE_WAIT_TIMEOUT_MS=120000
