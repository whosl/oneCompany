# Workflow agents — any OpenAI-compatible LLM endpoint
OC_LLM_API_KEY=
OC_LLM_BASE_URL=https://api.deepseek.com/v1
OC_WORKFLOW_MODEL_CHEAP=deepseek-v4-flash
OC_WORKFLOW_MODEL_STANDARD=deepseek-v4-flash
OC_WORKFLOW_MODEL_STRONG=deepseek-v4-pro

# Optional legacy aliases (plain model ids only; provider/model refs are for opencode)
# OPENAI_API_KEY=
# OC_MODEL_CHEAP=
# OC_MODEL_STANDARD=
# OC_MODEL_STRONG=

# Tests / local stub engine
# OC_USE_STUB_ENGINE=1

# Roll back to hand-rolled requirement/development engines (pre-LangGraph)
# OC_USE_LEGACY_ENGINE=1

# Real opencode integration tests
# OC_OPENCODE_INTEGRATION=1

# Web dev (apps/web/.env.local)
# NEXT_PUBLIC_API_URL=/api
# API_URL=http://localhost:3001

# --- OpenCode coding harness (slice implementation via @opencode-ai/sdk) ---
# CLI: install opencode and ensure the API process can find it (Homebrew: /opt/homebrew/bin).
# Coding harness CLI (default: mimo if on PATH, else opencode)
# OC_OPENCODE_BIN=/opt/homebrew/bin/mimo
#
# Model refs must be provider/model (NOT plain DeepSeek ids — those are for workflow agents only).
# Option A — env (recommended for OneCompany repo .env):
OC_OPENCODE_PROVIDER=xiaomi-token-plan-cn
OC_OPENCODE_MODEL_STRONG=xiaomi-token-plan-cn/mimo-v2.5-pro
OC_OPENCODE_MODEL_STANDARD=xiaomi-token-plan-cn/mimo-v2.5-pro
OC_OPENCODE_MODEL_CHEAP=xiaomi-token-plan-cn/mimo-v2.5-pro
#
# Option B — local opencode auth store (used if env models unset):
#   ~/.local/share/opencode/auth.json  (e.g. xiaomi-token-plan-cn / zhipuai-coding-plan)
#
# Optional provider API key override (otherwise read from auth.json):
# OC_OPENCODE_API_KEY=
# ZHIPU_API_KEY=
#
# Gate wait timeout (ms). Development/opencode permission gates default to 0 = wait until user resolves.
# OC_GATE_WAIT_TIMEOUT_MS=0
# OC_GATE_WAIT_TIMEOUT_MS=120000
# OC_OPENCODE_SLICE_TIMEOUT_MS=600000
#
# Minimum cumulative clarification questions before PRD generation.
# Defaults: 6 in real engine mode, 0 in stub/test mode. Skipping clarification waives the floor.
# OC_MIN_TOTAL_QUESTIONS=6
