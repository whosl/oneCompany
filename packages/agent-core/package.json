{
  "name": "@oc/agent-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external @oc/shared --external @oc/integrations --external @opencode-ai/sdk --external drizzle-orm --external @langchain/langgraph --external @langchain/core --external @langchain/openai",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^11.8.1",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@langchain/core": "^0.3.42",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/openai": "^0.3.17",
    "@oc/integrations": "workspace:^",
    "@oc/shared": "workspace:^",
    "@opencode-ai/sdk": "1.0.157",
    "drizzle-orm": "^0.39.3",
    "zod": "^3.24.1"
  }
}
